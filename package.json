{
  "name": "apptly-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s build:nuxt build:_packages",
    "build:_packages": "pnpm -r build",
    "build:nuxt": "nuxt build",
    "cf:deploy": "pnpm -r cf:deploy",
    "cf:preview": "pnpm -r cf:preview",
    "check": "run-s lint:check type-check build",
    "clean": "pnpm -r clean && rimraf .output .nuxt node_modules",
    "cspell": "cspell --config internal/build/cspell.json \"**\"",
    "dev": "nuxt cleanup && nuxt dev",
    "dev:prepare": "run-s prepare:_nuxt prepare:_packages",
    "generate": "nuxt generate",
    "lint": "run-s lint:_fix type-check cspell lint:_packages",
    "lint:_check": "eslint --ignore-pattern 'apps/**' .",
    "lint:_fix": "eslint --ignore-pattern 'apps/**' --fix .",
    "lint:_packages": "pnpm -r lint",
    "lint:check": "run-s lint:_check type-check cspell lint:check:_packages",
    "lint:check:_packages": "pnpm -r lint:check",
    "precommit": "run-s dev:prepare lint build",
    "prepare": "nuxt prepare",
    "prepare:_nuxt": "nuxt prepare",
    "prepare:_packages": "pnpm -r dev:prepare",
    "preview": "run-s build preview:_packages",
    "preview:_packages": "pnpm -r dev",
    "type-check": "run-s type-check:nuxt type-check:tools type-check:_packages",
    "type-check:_packages": "pnpm -r type-check",
    "type-check:nuxt": "nuxt typecheck",
    "type-check:tools": "tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "nuxt": "^4.4.4",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/content": "^3.12.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@poupe/eslint-config": "^0.9.1",
    "@poupe/tailwindcss": "^0.5.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.6.2",
    "cspell": "^10.0.0",
    "eslint": "^9.39.4",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.91.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  },
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10.33"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
