{
  "name": "apptly-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check": "run-s lint:check type-check build",
    "clean": "rimraf .output .nuxt node_modules",
    "cspell": "cspell --config internal/build/cspell.json \"**\"",
    "dev": "nuxt cleanup && nuxt dev",
    "dev:prepare": "nuxt prepare",
    "generate": "nuxt generate",
    "lint": "run-s lint:_fix type-check cspell",
    "lint:_check": "eslint .",
    "lint:_fix": "eslint . --fix",
    "lint:check": "run-s lint:_check type-check cspell",
    "precommit": "run-s dev:prepare lint build",
    "prepare": "nuxt prepare",
    "preview": "wrangler dev",
    "type-check": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.4.2",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "@nuxt/content": "^3.12.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.2.1",
    "@poupe/eslint-config": "~0.9.1",
    "@poupe/tailwindcss": "^0.5.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.6.2",
    "cspell": "^10.0.0",
    "eslint": "^9.39.4",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  },
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10.33"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
