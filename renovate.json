{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "Nuxt.js",
      "groupSlug": "nuxt",
      "matchPackageNames": [
        "@nuxt/**",
        "@nuxtjs/**",
        "nuxt",
        "/^nuxt-.*$/"
      ]
    },
    {
      "groupName": "Cloudflare",
      "groupSlug": "cloudflare",
      "matchPackageNames": [
        "@cloudflare/**",
        "wrangler",
        "nitro-cloudflare-dev"
      ]
    },
    {
      "groupName": "Poupe",
      "groupSlug": "poupe",
      "matchPackageNames": [
        "@poupe/**"
      ]
    }
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "rangeStrategy": "bump"
}
